# Admin dashboard — copy to .env.local and Netlify env vars

# Neon Postgres (project: ahmadnehela-admin)
DATABASE_URL=postgresql://...

# Admin login (choose a strong password)
ADMIN_PASSWORD=

# Random secret for session cookies (32+ characters)
ADMIN_SESSION_SECRET=

# Optional: dedicated key for encrypting site login passwords (32+ chars).
# Falls back to ADMIN_SESSION_SECRET if unset.
CREDENTIALS_ENCRYPTION_KEY=

# Stripe (TopWebDeveloper) — optional for now; payment links work without this.
# Add when you need API invoices / webhooks.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Existing
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Copy to .env.local (and set the same keys in Netlify → Site settings → Environment variables)

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# REQUIRED for reliable inbox delivery (not spam):
# 1. In Resend → Domains, add your domain and add the DNS records they show (SPF, DKIM, DMARC).
# 2. Use a "From" address on that domain, e.g.:
# RESEND_FROM_EMAIL=Ahmad Nehela <hello@yourdomain.com>
# Leaving this unset falls back to onboarding@resend.dev, which often goes to Promotions/Spam.

# Optional — where inquiries are sent (default: topwebdeveloperan@gmail.com)
# CONTACT_TO_EMAIL=you@example.com

NEXT_PUBLIC_SITE_URL=https://yourdomain.com
